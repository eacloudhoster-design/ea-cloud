{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ea-cloud-website",
  "pages_build_output_dir": "artifacts/ea-cloud/dist",
  "compatibility_date": "2026-10-19",
  "r2_buckets": [
    {
      "binding": "BACKGROUND_IMAGES",
      "bucket_name": "ea-cloud-backgrounds"
    }
  ],
  "env": {
    "preview": {
      "r2_buckets": [
        {
          "binding": "BACKGROUND_IMAGES",
          "bucket_name": "ea-cloud-backgrounds-preview"
        }
      ]
    }
  }
}

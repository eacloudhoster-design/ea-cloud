# Names only. Set privately on the EXISTING Render service after approval.
# Retain original DATABASE_URL and SESSION_SECRET; never substitute fixture values.
EA_RELEASE_MODE=nontrading
EA_MT5_MANAGEMENT_ONLY=1
NODE_ENV=production
# Render supplies PORT; the entry binds 0.0.0.0 and accepts 1024..65535.
# EA_APPLICATION_ORIGIN_TOKEN=<same private value as Pages BACKEND_PROXY_TOKEN>
# PUBLIC_WEBSITE_ORIGIN=https://eacloudhoster.online
# AUTH_ALLOWED_ORIGINS=<retain reviewed production origin list>
# MT5_VPS_URL=<approved HTTPS status-only gateway origin>
# MT5_VPS_TOKEN=<existing dedicated relay bearer token>
MT5_ACCESS_REQUIRED=1
# MT5_ACCESS_CLIENT_ID=<private Access service-token client ID>
# MT5_ACCESS_CLIENT_SECRET=<private Access service-token client secret>
# Preserve all unrelated existing configuration. Do not set EA_ENGINE_READ_ONLY=1.
# Do not add execution bridge tokens merely to make status work.

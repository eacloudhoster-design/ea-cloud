# Revalidate installation metadata; fingerprinted JS/CSS keep their normal cache policy.
/build-info.json
  Cache-Control: no-store
/ea-app/
  Cache-Control: no-cache
/ea-app/index.html
  Cache-Control: no-cache
/ea-app/push-sw.js
  Cache-Control: no-cache
/ea-app/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8
# Website icon URLs revalidate; versioned HTML references bypass old favicon keys.
/favicon.ico
  Cache-Control: no-cache
/favicon.svg
  Cache-Control: no-cache
/apple-touch-icon.png
  Cache-Control: no-cache
/ea-cloud-icon-*.png
  Cache-Control: no-cache
/site.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8

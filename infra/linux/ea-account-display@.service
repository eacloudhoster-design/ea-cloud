[Unit]
Description=EA Cloud private demo display %i
[Service]
User=ea-account-%i
Group=ea-account-%i
EnvironmentFile=/etc/ea-cloud/accounts/%i/runtime.env
ExecStart=/usr/bin/Xvfb ${DISPLAY} -screen 0 1280x800x24 -nolisten tcp -noreset -auth /var/lib/ea-cloud/accounts/%i/.Xauthority
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp

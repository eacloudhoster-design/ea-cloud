# Prepared only. Requires an approved alert destination; never sends during tests.
[Unit]
Description=EA Cloud combined host and engine alert outbox
After=ea-engine-inventory.service
[Service]
Type=oneshot
User=ea-monitor
Group=ea-monitor
EnvironmentFile=-/etc/ea-cloud/alerts.env
ExecStart=/usr/bin/python3 /opt/ea-cloud/infra/linux/engine-alerts.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ea-cloud/monitor
TimeoutStartSec=120

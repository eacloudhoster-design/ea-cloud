# Prepared only. No migration/start script or normal API startup jobs.
[Unit]
Description=EA Cloud engine read-only canary
After=network-online.target
ConditionPathExists=/etc/ea-cloud/engine-readonly.env
[Service]
User=ea-engine-api
Group=ea-engine-api
EnvironmentFile=/etc/ea-cloud/engine-readonly.env
Environment=EA_ENGINE_READ_ONLY=1
Environment=PORT=8014
ExecStart=/usr/bin/node /opt/ea-cloud/releases/engine-readonly/engine-readonly.mjs
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=300M
TasksMax=50
[Install]
WantedBy=multi-user.target

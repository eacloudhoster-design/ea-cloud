# REVIEW ONLY. Do not install/start without separate infrastructure approval.
[Unit]
Description=EA Cloud private read-only account provisioner
After=network.target
[Service]
Type=simple
User=root
UMask=0077
Environment=MT5_PRIVATE_PROVISIONER_ENABLED=0
Environment=MT5_PRIVATE_PROVISIONER_CONFIG=/etc/ea-cloud/private-provisioner/config.json
ExecStart=/usr/bin/node /opt/ea-cloud/releases/REVIEW_REQUIRED/infra/provisioning/private-service.cjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target

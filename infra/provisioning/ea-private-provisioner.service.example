# REVIEW ONLY. Do not install/start without separate infrastructure approval.
[Unit]
StartLimitIntervalSec=120
StartLimitBurst=3
Description=EA Cloud private read-only account provisioner
After=network.target
[Service]
Type=simple
User=root
UMask=0077
Environment=MT5_PRIVATE_PROVISIONER_ENABLED=0
Environment=MT5_PRIVATE_PROVISIONER_CONFIG=/etc/ea-cloud/private-provisioner/config.json
ExecStart=/usr/bin/node /opt/ea-cloud/releases/REVIEW_REQUIRED/infra/provisioning/private-service.cjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ea-cloud/private-provisioner /var/lib/ea-cloud/selfservice-accounts /tmp
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=96
[Install]
WantedBy=multi-user.target
